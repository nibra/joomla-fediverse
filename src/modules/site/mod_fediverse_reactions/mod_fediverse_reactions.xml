<?xml version="1.0" encoding="UTF-8"?>
<extension type="module" client="site" method="upgrade">
    <name>MOD_FEDIVERSE_REACTIONS</name>
    <author>Niels Braczek</author>
    <creationDate>Feb 2026</creationDate>
    <copyright>(C) 2026 BSDS / nibra Consulting</copyright>
    <license>GNU General Public License version 2 or later; see LICENSE.txt</license>
    <authorEmail>nbraczek@bsds.de</authorEmail>
    <authorUrl>code.nibra.net</authorUrl>
    <version>__DEPLOY_VERSION__</version>
    <description>MOD_FEDIVERSE_REACTIONS_XML_DESCRIPTION</description>
    <namespace path="src">NX\Module\Fediverse\Reactions</namespace>

    <files>
        <folder module="mod_fediverse_reactions">services</folder>
        <folder>src</folder>
        <folder>tmpl</folder>
    </files>
    <languages>
        <language tag="en-GB">language/en-GB/mod_fediverse_reactions.ini</language>
        <language tag="en-GB">language/en-GB/mod_fediverse_reactions.sys.ini</language>
    </languages>
    <config>
        <fields name="params">
            <fieldset name="options" label="COM_MODULES_BASIC_FIELDSET_LABEL">
                <field
                    name="source"
                    type="list"
                    label="MOD_FEDIVERSE_REACTIONS_FIELD_SOURCE_LABEL"
                    default="current"
                    validate="options"
                >
                    <option value="current">MOD_FEDIVERSE_REACTIONS_FIELD_SOURCE_CURRENT</option>
                    <option value="object_id">MOD_FEDIVERSE_REACTIONS_FIELD_SOURCE_OBJECT_ID</option>
                </field>
                <field
                    name="object_id"
                    type="text"
                    label="MOD_FEDIVERSE_REACTIONS_FIELD_OBJECT_ID_LABEL"
                    description="MOD_FEDIVERSE_REACTIONS_FIELD_OBJECT_ID_DESC"
                />
                <field
                    name="show_reactions"
                    type="radio"
                    layout="joomla.form.field.radio.switcher"
                    label="MOD_FEDIVERSE_REACTIONS_FIELD_SHOW_REACTIONS_LABEL"
                    default="1"
                    filter="integer"
                >
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
                <field
                    name="show_replies"
                    type="radio"
                    layout="joomla.form.field.radio.switcher"
                    label="MOD_FEDIVERSE_REACTIONS_FIELD_SHOW_REPLIES_LABEL"
                    default="1"
                    filter="integer"
                >
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
                <field
                    name="reply_limit"
                    type="number"
                    label="MOD_FEDIVERSE_REACTIONS_FIELD_REPLY_LIMIT_LABEL"
                    description="MOD_FEDIVERSE_REACTIONS_FIELD_REPLY_LIMIT_DESC"
                    default="10"
                    min="0"
                    filter="integer"
                />
                <field
                    name="show_like_button"
                    type="radio"
                    layout="joomla.form.field.radio.switcher"
                    label="MOD_FEDIVERSE_REACTIONS_SHOW_LIKE_BUTTON"
                    default="1"
                    filter="integer"
                >
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
                <field
                    name="show_boost_button"
                    type="radio"
                    layout="joomla.form.field.radio.switcher"
                    label="MOD_FEDIVERSE_REACTIONS_SHOW_BOOST_BUTTON"
                    default="1"
                    filter="integer"
                >
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
            </fieldset>
            <fieldset name="advanced">
                <field
                    name="layout"
                    type="modulelayout"
                    label="JFIELD_ALT_LAYOUT_LABEL"
                    class="form-select"
                    validate="moduleLayout"
                />
                <field
                    name="moduleclass_sfx"
                    type="textarea"
                    label="COM_MODULES_FIELD_MODULECLASS_SFX_LABEL"
                    rows="3"
                    validate="CssIdentifier"
                />
            </fieldset>
        </fields>
    </config>
</extension>
